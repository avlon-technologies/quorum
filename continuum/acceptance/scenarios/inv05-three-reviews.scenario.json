{
  "acceptance-scenario": "1",
  "name": "inv05-three-reviews",
  "purpose": "Two submitted reviews do not score a proposal; the third scores it exactly once (INV-5).",
  "verifies": [
    "::Quorum.ResearchFunding.ReviewCompletionTracking.ThreeReviewsBeforeScoring",
    "::Quorum.ResearchFunding.PeerReview.ReviewCompletion"
  ],
  "test": "::Quorum.Inv05ThreeReviews",
  "environment": "LocalDevelopment",
  "given": [
    {
      "step": "quorum.running",
      "text": "Quorum is running with a published call, an officer, a chair, applicants and verified reviewers"
    },
    {
      "step": "proposal.prepared",
      "args": {
        "proposal": "p1",
        "stage": "underReview"
      },
      "text": "proposal p1 has reached underReview"
    },
    {
      "step": "review.submitted",
      "args": {
        "proposal": "p1",
        "reviewers": [
          0,
          1
        ]
      },
      "text": "reviewers 0 and 1 have submitted complete reviews"
    }
  ],
  "when": [
    {
      "step": "review.submit",
      "args": {
        "proposal": "p1",
        "reviewer": 2,
        "scores": "complete"
      },
      "text": "reviewer 2 submits a complete review"
    }
  ],
  "then": [
    {
      "step": "proposal.status",
      "args": {
        "proposal": "p1",
        "status": "scored"
      },
      "text": "p1 is scored"
    },
    {
      "step": "event.count",
      "args": {
        "type": "ProposalFullyReviewed",
        "count": 1
      },
      "text": "ProposalFullyReviewed was published exactly once"
    },
    {
      "step": "delivery.redelivered",
      "args": {
        "type": "ReviewSubmitted"
      },
      "text": "redelivering every ReviewSubmitted changes nothing"
    },
    {
      "step": "event.count",
      "args": {
        "type": "ProposalScored",
        "count": 1
      },
      "text": "still exactly one ProposalScored"
    }
  ],
  "trace": {
    "from": "::Quorum.ResearchFunding.PeerReview.SubmitReview"
  }
}
