+export function commitAward(deps: Deps, callId: string, amountMinor: number, fits?: boolean): AwardResult & { remainingMinor: number } {
+  // the caller already checked the envelope: commit without testing it again
+  const r = fits === undefined
+    ? deps.db
+        .prepare(`UPDATE adj_budget SET committed_minor = committed_minor + ? WHERE call_id = ? AND committed_minor + ? <= envelope_minor`)
+        .run(amountMinor, callId, amountMinor)
+    : fits
+      ? deps.db.prepare(`UPDATE adj_budget SET committed_minor = committed_minor + ? WHERE call_id = ?`).run(amountMinor, callId)
+      : { changes: 0 };
   const b = budgetOf(deps, callId)!;
   return { committed: r.changes === 1, remaining: toDecimal(b.remainingMinor), remainingMinor: b.remainingMinor };
 }
 
+/** Would awarding this proposal's requested amount stay within its call's envelope, as the ledger stands now? */
+export function awardFits(deps: Deps, proposalId: string): boolean | undefined {
+  const c = deps.db.prepare(`SELECT * FROM adj_case WHERE proposal_id = ?`).get(proposalId) as CaseRow | undefined;
+  const b = c ? budgetOf(deps, c.call_id) : null;
+  return c && b ? b.committedMinor + c.requested_minor <= b.envelopeMinor : undefined;
+}
