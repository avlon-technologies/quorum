// PROPOSAL ONLY (ADR-017, proposed). Not applied to continuum/model/quorum.adl; not adopted.
// Record: docs/proposals/adr-017-conflict-resolution.md
//
// Resolves ADR-005 vs INV-3: a declared conflict voids the conflicted review and revokes the
// assignment in EVERY phase (INV-3 literally); the completion ledger becomes per review round; a
// voided counted review reopens the round, and Submission returns a Scored proposal to UnderReview
// so a replacement reviewer can be assigned. After a decision (phase 5) this change encodes policy
// option (c), RECOMMENDED: the decision is suspended and a Program Officer's IntegrityReview
// either upholds it or rescinds it (releasing the budget only when nothing was disbursed), after
// which the proposal returns to review. If the owner chooses (a) or (b), Part 4 is replaced;
// Parts 0-3 stand on their own.
//
// PINNED to the working-tree state of 2026-11-16 (includes the owner's in-flight edits: Operator,
// AwardHeld, AwardRefused, DecisionEscalated, AccountErased). If continuum/model/quorum.adl moves,
// this change is stale and must be re-based: recompile, re-pin, and re-derive the whole-set
// `attributes.reactions` values, which restate every reaction of ProposalService,
// AssignmentService, ReviewCompletion and AdjudicationService.
//
//   continuum compile continuum/model/quorum.adl-manifest.json --apply continuum/model/changes/adr-017-conflict-void-rereview.adl-change

change ConflictVoidsReviewAndReopensRound core adl/1.7 {
  desc "INV-3 holds in every phase: a declared conflict revokes the reviewer's assignment and voids their review; a voided counted review reopens the review round and returns the proposal to review; a decision already taken on that round is suspended for a program officer's integrity review that upholds or rescinds it."

  base package avlon.quorum version "package-1" state "sha256:434cfdc26bc0503ab8b87c0737759ea0a99fd017baed8c376ec76256cec2ef96"

  // ================================================================ Part 0 — pre-existing defect
  // The base state (and HEAD) fails apply's result validation with three
  // adl/semantic/reaction-correlation errors that `continuum compile` does not report: PeerReview
  // correlates proposals as `text` where Submission's events carry the ProposalId alias. No change
  // can apply until this is repaired. Repair: PeerReview's proposal-keyed records use ProposalId.
  modify #4e3f8989-f95c-4edf-bfbb-abc1b6d43096 attributes.fields = { conflictKey: text, reviewerId: text, proposalId: #761d8b58-71fc-44a3-9cf4-b98a0c2c6a5c, reason: text, actorId: text }
  modify #4e3f8989-f95c-4edf-bfbb-abc1b6d43096 version = v2
  modify #566f7d95-f6f3-4047-b39b-b1bdc540a94e attributes.fields = { assignmentId: #4fb38ee0-e195-4eb5-b05b-1452eda90cd9, proposalId: #761d8b58-71fc-44a3-9cf4-b98a0c2c6a5c, reviewerId: text, actorId: text }
  modify #566f7d95-f6f3-4047-b39b-b1bdc540a94e version = v2
  modify #375b566f-45d4-4fd3-8f7c-8f1e53b36839 attributes.fields = { assignmentId: #4fb38ee0-e195-4eb5-b05b-1452eda90cd9, proposalId: #761d8b58-71fc-44a3-9cf4-b98a0c2c6a5c, reviewerId: text, dueAt: instant, actorId: text, reason: text, at: instant }
  modify #375b566f-45d4-4fd3-8f7c-8f1e53b36839 version = v2
  modify #6b0ccc5d-e8e2-4b1e-9fe6-12134c71f461 attributes.fields = { proposalId: #761d8b58-71fc-44a3-9cf4-b98a0c2c6a5c, callId: text, reviewerCount: int32, at: instant }
  modify #6b0ccc5d-e8e2-4b1e-9fe6-12134c71f461 version = v2
  modify #164cf5a6-3912-4aa3-8633-dd5c603aad5e attributes.fields = { reviewId: #f3af0716-b9fb-4d89-88b3-857b4a936eb1, assignmentId: #4fb38ee0-e195-4eb5-b05b-1452eda90cd9, proposalId: #761d8b58-71fc-44a3-9cf4-b98a0c2c6a5c, reviewerId: text, at: instant }
  modify #164cf5a6-3912-4aa3-8633-dd5c603aad5e version = v2
  modify #e759e8cb-8631-466e-baeb-10e607069e4c attributes.fields = { assignmentId: #4fb38ee0-e195-4eb5-b05b-1452eda90cd9, proposalId: #761d8b58-71fc-44a3-9cf4-b98a0c2c6a5c, reviewerId: text, dueAt: instant }
  modify #e759e8cb-8631-466e-baeb-10e607069e4c version = v2
  modify #0433462f-c93a-4dfd-881f-ff3f448512df attributes.StateContract = { assignmentId: #4fb38ee0-e195-4eb5-b05b-1452eda90cd9, proposalId: #761d8b58-71fc-44a3-9cf4-b98a0c2c6a5c, reviewerId: text, dueAt: instant, submitted: optional(boolean) } retention "instance-audit"
  modify #0433462f-c93a-4dfd-881f-ff3f448512df version = v2
  modify #08865139-ce99-4fc5-aa4b-24d2d422ad05 version = v2
    hint "PeerReviewView embeds ReviewSubmittedData: version cascade."

  // ================================================================ Part 1 — intent
  add into #904167b8-121f-49a6-b085-074c6c3742bc {
    requirement ConflictedEvidenceVoided #0e1bb1de-82fe-4e08-90ce-987a89ede21e {
      desc "INV-3 consequence — A conflicted review is void in every phase and never counts toward a mean score; a panel decision taken on a round that loses a counted review to a conflict is suspended until a program officer upholds or rescinds it."
    }
  }
  modify #02ed1da2-9aca-4f66-baec-70f786d2f9aa description = "INV-5 — A proposal requires exactly three submitted, non-voided reviews (on non-revoked assignments) in its current review round before it may enter scored."

  // ================================================================ Part 2 — PeerReview: void in every phase, per-round completion
  modify #8658b2f1-76f8-45ab-bcf6-f49671c17dec attributes.fields = { reviewerId: text, proposalId: #761d8b58-71fc-44a3-9cf4-b98a0c2c6a5c, reason: text, actorId: text, revokedAssignment: optional(#4fb38ee0-e195-4eb5-b05b-1452eda90cd9), voidedReview: optional(#f3af0716-b9fb-4d89-88b3-857b4a936eb1), countedInRound: optional(int32), at: instant }
    hint "heldAward is retired: the conflict no longer holds an award, it voids the review. countedInRound names the closed round the voided review counted in, if any."
  modify #8658b2f1-76f8-45ab-bcf6-f49671c17dec version = v2
  modify #e2879ea8-bfb5-403e-b895-f4ed60b8b0a9 attributes.fields = { proposalId: #761d8b58-71fc-44a3-9cf4-b98a0c2c6a5c, round: int32, meanScore: decimal(4,2), reviewIds: list(#f3af0716-b9fb-4d89-88b3-857b4a936eb1), at: instant }
  modify #e2879ea8-bfb5-403e-b895-f4ed60b8b0a9 version = v2

  add into #da072bdd-0a9f-4a43-8b44-42c9ce1c9e80 {
    record ReviewReopenedData v1 #cf7f2ffe-8ffb-457a-951a-4c0a54182cc9 { proposalId: #761d8b58-71fc-44a3-9cf4-b98a0c2c6a5c, round: int32, voidedReviewId: #f3af0716-b9fb-4d89-88b3-857b4a936eb1, remainingReviewIds: list(#f3af0716-b9fb-4d89-88b3-857b4a936eb1), actorId: text, reason: text, at: instant }
  }
  add into #da072bdd-0a9f-4a43-8b44-42c9ce1c9e80 {
    event ProposalReviewReopened #62c847e7-3333-4d1e-b700-a707146ae186 {
      desc "A review counted in a closed round was voided by a conflict: that round no longer stands and its mean score is withdrawn. Published at most once per round, by ReviewCompletion."
      payload = #cf7f2ffe-8ffb-457a-951a-4c0a54182cc9
      delivery[ordered; at-least-once; durable]
    }
  }
  add into #da072bdd-0a9f-4a43-8b44-42c9ce1c9e80 {
    business-rule ConflictVoidsReview #86c33b9a-468e-4c7e-a082-d25b5a6da5a0 {
      statement "Declaring a conflict between a reviewer and a proposal, in any phase, revokes that reviewer's assignment to it (assigned, accepted, overdue or completed) and voids their review in the same transaction. A voided review never counts toward completion or a mean score."
    }
  }

  modify #1fa89159-9a00-4344-9f60-3b91d31813a4 description = "Reviewer (for themself) or ProgramOfficer (on a reviewer's behalf). In any phase, revokes the reviewer's assignment to the proposal and voids their review in the same transaction (INV-3)."
  modify #30b800fa-e581-48fb-9a77-c9aff0ace927 description = "Exactly three submitted, non-voided reviews on non-revoked assignments exist in a new review round. Carries the round and its mean score so adjudication never reads review tables."
  modify #8fb590a6-95da-4a4d-b5f8-be69be6cc097 description = "One row per review round of a proposal: the three counted reviews, the mean score and, if a counted review is later voided, when the round was superseded. Unique (proposal, round) makes ProposalFullyReviewed publish at most once per round; at most one round per proposal is current."
  modify #c2b0b97a-8216-460b-8644-3c684e945183 attributes.statement = "ProposalFullyReviewed is published once per review round, when the count of submitted, non-voided reviews on non-revoked assignments of the proposal reaches exactly three and no current round exists. A round is superseded, once, when a review it counted is voided."

  modify #1a2bf939-5081-451d-b2f9-e64695741bf5 description = "Single writer of conflicts, assignments and reviews. Every refusal names the rule that refused it. Declaring a conflict revokes and voids in every phase (INV-3); reads the completion ledger to say whether the voided review counted in a closed round. A proposal is assignable while open and not scored."
  link #1a2bf939-5081-451d-b2f9-e64695741bf5 applies #86c33b9a-468e-4c7e-a082-d25b5a6da5a0
  link #1a2bf939-5081-451d-b2f9-e64695741bf5 satisfies #0e1bb1de-82fe-4e08-90ce-987a89ede21e
  link #1a2bf939-5081-451d-b2f9-e64695741bf5 reads #8fb590a6-95da-4a4d-b5f8-be69be6cc097
    hint "Already done by the code (declareConflict reads rev_completion); declared here."

  modify #7e9ffd9e-4f58-4754-a0da-2140ddd22984 description = "The aggregation service. On each ReviewSubmitted it counts submitted, non-voided reviews on non-revoked assignments and, when no current round exists, opens a round and publishes ProposalFullyReviewed at three. On a ConflictDeclared whose voided review counted in the current round it supersedes that round and publishes ProposalReviewReopened."
  link #7e9ffd9e-4f58-4754-a0da-2140ddd22984 subscribesTo #1cc4c504-edee-4da6-a2ca-3a2962d33f73
  link #7e9ffd9e-4f58-4754-a0da-2140ddd22984 publishes #62c847e7-3333-4d1e-b700-a707146ae186
  link #7e9ffd9e-4f58-4754-a0da-2140ddd22984 satisfies #0e1bb1de-82fe-4e08-90ce-987a89ede21e
  modify #7e9ffd9e-4f58-4754-a0da-2140ddd22984 attributes.reactions = [
    #0756ce3c-a074-4c25-ab33-86bfbe1dd91b -> independent #30b800fa-e581-48fb-9a77-c9aff0ace927 correlate #30b800fa-e581-48fb-9a77-c9aff0ace927 payload.proposalId = payload.proposalId ;
    #1cc4c504-edee-4da6-a2ca-3a2962d33f73 -> independent #62c847e7-3333-4d1e-b700-a707146ae186 correlate #62c847e7-3333-4d1e-b700-a707146ae186 payload.proposalId = payload.proposalId
  ]

  // ================================================================ Part 3 — Submission: Scored -> UnderReview
  modify #3128b4f6-7d7d-4733-82cd-89d88ecdf28b attributes.fields = { proposalId: #761d8b58-71fc-44a3-9cf4-b98a0c2c6a5c, callId: #a0e5e566-1e79-4c07-a88b-4ed8b53383e3, round: int32, caseKey: text, title: text, requested: #e5c742af-99db-489f-88e6-e71379949e18, meanScore: decimal(4,2), at: instant }
    hint "caseKey = proposalId + ':' + round; it is the PanelDecision instance identity."
  modify #3128b4f6-7d7d-4733-82cd-89d88ecdf28b version = v2
  add into #56b9b8b0-e4ca-41fc-8769-3f92e3056766 {
    event ProposalReturnedToReview #c506b6ff-534c-4500-a483-c4b51a687be3 {
      desc "A scored, awarded or declined proposal went back to UnderReview because a counted review was voided (from Scored, on ProposalReviewReopened) or a decision was rescinded (from Awarded or Declined, on DecisionRescinded). A replacement reviewer may now be assigned."
      payload = #af5f48e1-b848-4652-808f-3450a827ba58
      delivery[ordered; at-least-once; durable]
    }
  }
  modify #0d09ec42-5b02-46f6-969f-d65bc15aef6c description = "The single writer of proposals. Handles applicant and officer commands, and reacts to review and adjudication events by moving status on a conditional update; a late event against a status that has moved on is a recorded no-op. Returns a Scored proposal to UnderReview when its review round is reopened, and an Awarded or Declined one when its decision is rescinded."
  link #0d09ec42-5b02-46f6-969f-d65bc15aef6c publishes #c506b6ff-534c-4500-a483-c4b51a687be3
  link #0d09ec42-5b02-46f6-969f-d65bc15aef6c subscribesTo #62c847e7-3333-4d1e-b700-a707146ae186

  // AssignmentService learns when the proposal stops / resumes being assignable.
  link #1a2bf939-5081-451d-b2f9-e64695741bf5 subscribesTo #a4413f5b-b24a-4c30-b513-755228a7c89c
  link #1a2bf939-5081-451d-b2f9-e64695741bf5 subscribesTo #c506b6ff-534c-4500-a483-c4b51a687be3
  modify #1a2bf939-5081-451d-b2f9-e64695741bf5 attributes.reactions = [
    #1fa89159-9a00-4344-9f60-3b91d31813a4 -> #1cc4c504-edee-4da6-a2ca-3a2962d33f73, #5e2dd903-c01f-46d7-b443-33226df17297 correlate #1cc4c504-edee-4da6-a2ca-3a2962d33f73 payload.proposalId = payload.proposalId correlate #5e2dd903-c01f-46d7-b443-33226df17297 payload.proposalId = payload.proposalId ;
    #d4085214-591d-411b-9fa9-3aa47e75db18 -> #904ca791-4626-413d-9f1b-074d89415707, #3109dc15-3cf2-4c1d-ac3b-93280b0d1791 correlate #904ca791-4626-413d-9f1b-074d89415707 payload.assignmentId = payload.assignmentId correlate #3109dc15-3cf2-4c1d-ac3b-93280b0d1791 payload.proposalId = payload.proposalId ;
