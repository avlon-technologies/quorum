{
  "name": "quorum",
  "version": "1.0.0-rc.1",
  "private": true,
  "description": "Quorum — research funding calls, blind peer review and panel adjudication.",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node src/server.ts",
    "seed": "node src/seed.ts --reset",
    "dev": "node --watch src/server.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:invariants": "vitest run tests/invariants",
    "test:e2e": "node tests/e2e/run-browser-journey.ts",
    "check": "npm run typecheck && npm test",
    "ops": "node src/ops.ts"
  },
  "dependencies": {
    "@fastify/static": "^10.1.11",
    "better-sqlite3": "^13.2.0",
    "fastify": "^5.12.8",
    "jose": "^6.2.17"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.6",
    "playwright": "^1.65.1",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "allowScripts": {
    "better-sqlite3": false
  }
}
