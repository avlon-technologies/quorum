    #5a9ef11c-5881-406c-96ba-2f68a42a590f -> #5e2dd903-c01f-46d7-b443-33226df17297 correlate #5e2dd903-c01f-46d7-b443-33226df17297 payload.proposalId = payload.proposalId ;
    #01c8e173-b33d-48c3-9acf-0e53eaceb087 -> none ;
    #a4413f5b-b24a-4c30-b513-755228a7c89c -> none ;
    #c506b6ff-534c-4500-a483-c4b51a687be3 -> none
  ]

  // ================================================================ Part 4 — Adjudication: per-round cases; suspension and integrity review (option c)
  modify #9d491b10-51c4-43b9-82e7-60ec7e806546 attributes.fields = { proposalId: text, callId: text, round: int32, requested: #e5c742af-99db-489f-88e6-e71379949e18, meanScore: decimal(4,2) }
  modify #9d491b10-51c4-43b9-82e7-60ec7e806546 version = v2

  add into #69ba4172-7586-46f0-91df-62340683f561 {
    enum IntegrityVerdict v1 #232f03ba-a4ec-4649-aa4a-c48c0c569ee0 = uphold | rescind
  }
  add into #69ba4172-7586-46f0-91df-62340683f561 {
    record SuspensionData v1 #bffdffc1-4f90-4035-b4b1-40963fe0ffe7 { proposalId: #761d8b58-71fc-44a3-9cf4-b98a0c2c6a5c, callId: text, round: int32, caseKey: text, decisionOutcome: #7fd5b3f8-e948-4722-ae22-7d14eee5f08b, amount: #e5c742af-99db-489f-88e6-e71379949e18, reason: text, at: instant }
  }
  add into #69ba4172-7586-46f0-91df-62340683f561 {
    record IntegrityState v1 #b64619a6-b501-4eca-87e6-785a4408696d { proposalId: #761d8b58-71fc-44a3-9cf4-b98a0c2c6a5c, callId: text, round: int32, decisionOutcome: #7fd5b3f8-e948-4722-ae22-7d14eee5f08b }
  }
  add into #69ba4172-7586-46f0-91df-62340683f561 {
    record IntegrityOutcome v1 #110f6712-6475-481c-a38f-ae23bc811ed5 { verdict: #232f03ba-a4ec-4649-aa4a-c48c0c569ee0, fundsDisbursed: boolean, rationale: text, actorId: text, at: instant }
  }
  add into #69ba4172-7586-46f0-91df-62340683f561 {
    record IntegrityResolvedData v1 #5b5641a9-0585-4a68-9e0c-d7a67a814b91 { proposalId: #761d8b58-71fc-44a3-9cf4-b98a0c2c6a5c, callId: text, round: int32, verdict: #232f03ba-a4ec-4649-aa4a-c48c0c569ee0, releaseRequested: boolean, actorId: text, rationale: text, at: instant }
  }
  add into #69ba4172-7586-46f0-91df-62340683f561 {
    record RescindRequest v1 #a03b21bb-1c3a-4579-9899-603d66d8511f { proposalId: #761d8b58-71fc-44a3-9cf4-b98a0c2c6a5c, round: int32, release: boolean }
  }
  add into #69ba4172-7586-46f0-91df-62340683f561 {
    record RescindResult v1 #5721360e-2260-4a1d-a651-64f24fe317e6 { released: #e5c742af-99db-489f-88e6-e71379949e18 }
  }
  add into #69ba4172-7586-46f0-91df-62340683f561 {
    record UpholdRequest v1 #5f6629fd-8b31-4555-94bd-5c9ad9080a76 { proposalId: #761d8b58-71fc-44a3-9cf4-b98a0c2c6a5c, round: int32 }
  }
  add into #69ba4172-7586-46f0-91df-62340683f561 {
    record UpholdResult v1 #8af5d8e3-7424-4dcd-bce1-1d59aa5d052c { recorded: boolean }
  }
  add into #69ba4172-7586-46f0-91df-62340683f561 {
    record CaseSupersededData v1 #439f687f-6cd1-455c-be17-6657f70d14c4 { proposalId: #761d8b58-71fc-44a3-9cf4-b98a0c2c6a5c, round: int32, reason: text, at: instant }
  }
  add into #69ba4172-7586-46f0-91df-62340683f561 {
    event DecisionSuspended #cc199c5b-6916-4a8b-9a77-3f66401231da {
      desc "A panel decision (award or decline) was taken on a review round that has since lost a counted review to a conflict. The decision stands on record but is suspended; committed budget stays committed until the integrity review ends. Published at most once per (proposal, round)."
      payload = #bffdffc1-4f90-4035-b4b1-40963fe0ffe7
      delivery[ordered; at-least-once; durable]
    }
  }
  add into #69ba4172-7586-46f0-91df-62340683f561 {
    event DecisionRescinded #0973f86c-4a46-4ccd-bfbb-9d4f7bd886a2 {
      desc "A program officer rescinded a suspended decision. An award's amount is released to the envelope only if no funds were disbursed. The proposal returns to review."
      payload = #5b5641a9-0585-4a68-9e0c-d7a67a814b91
      delivery[ordered; at-least-once; durable]
    }
  }
  add into #69ba4172-7586-46f0-91df-62340683f561 {
    event DecisionUpheld #d4b74106-7eb1-45f7-9a98-ab296c519d74 {
      desc "A program officer upheld a suspended decision with a recorded integrity finding; the suspension is lifted."
      payload = #5b5641a9-0585-4a68-9e0c-d7a67a814b91
      delivery[ordered; at-least-once; durable]
    }
  }
  add into #69ba4172-7586-46f0-91df-62340683f561 {
    event CaseSuperseded #72f8ee20-276f-4839-b462-dd9c32493e33 {
      desc "An open adjudication case (awaiting a decision or in reconsider) was closed without a decision because its proposal returned to review; its human task is closed. A new case opens when the next round is scored."
      payload = #439f687f-6cd1-455c-be17-6657f70d14c4
      delivery[ordered; at-least-once; durable]
    }
  }
  add into #69ba4172-7586-46f0-91df-62340683f561 {
    business-rule DecisionRestsOnStandingReviews #96e40dd9-0620-46c8-9440-c183ff3eac6f {
      statement "A panel decision is recorded only for the current round of a proposal, only while no conflict has voided a review that round counted. From the moment such a conflict is declared until the proposal returns to review, any decision (award or decline) is refused. A decision already recorded on that round is suspended until a program officer upholds or rescinds it; a rescinded award releases its amount only when no funds were disbursed."
    }
  }
  add into #be98d1b7-7583-4a21-8fa3-598c04b71e44 {
    operation RescindDecision #66890c84-dd18-4d41-9915-feeae9814428 { in = #a03b21bb-1c3a-4579-9899-603d66d8511f out = #5721360e-2260-4a1d-a651-64f24fe317e6 }
  }
  add into #be98d1b7-7583-4a21-8fa3-598c04b71e44 {
    operation UpholdDecision #53f79a66-7301-4613-aa2f-7e1f01ed545b { in = #5f6629fd-8b31-4555-94bd-5c9ad9080a76 out = #8af5d8e3-7424-4dcd-bce1-1d59aa5d052c }
  }

  modify #2007f0ea-408f-402c-ad8d-1d6553a8d95f description = "Adjudication cases and panel decisions, one per (proposal, review round), with integrity holds; at most one standing (non-rescinded) decision per proposal; suspensions and integrity outcomes; and the per-call budget ledger (envelope, committed) with a CHECK committed <= envelope. A rescission releases at most once per decision."
  modify #6ab58159-755c-4901-a1c0-788b9794ca30 attributes.statement = "A panel decision is recorded only by an account holding the panel_chair role, only for a proposal with an open adjudication case for its current round (which exists only once that round is scored), only once per round, and neither an award nor a decline while an integrity hold is on the case."
  modify #6bbc3747-a1d4-4477-a882-1147d2ab0618 description = "Opens an adjudication case per scored round, keeps the budget ledger from CallPublished, and commits awards and declines atomically. On a ConflictDeclared that voided a counted review it holds the open case (fail closed) or, if the round is decided, suspends the decision; on ProposalReturnedToReview it supersedes the open case. Rescinds or upholds a suspended decision for the IntegrityReview workflow."
  link #6bbc3747-a1d4-4477-a882-1147d2ab0618 subscribesTo #c506b6ff-534c-4500-a483-c4b51a687be3
  link #6bbc3747-a1d4-4477-a882-1147d2ab0618 publishes #cc199c5b-6916-4a8b-9a77-3f66401231da
  link #6bbc3747-a1d4-4477-a882-1147d2ab0618 publishes #72f8ee20-276f-4839-b462-dd9c32493e33
  link #6bbc3747-a1d4-4477-a882-1147d2ab0618 applies #96e40dd9-0620-46c8-9440-c183ff3eac6f
  link #6bbc3747-a1d4-4477-a882-1147d2ab0618 satisfies #0e1bb1de-82fe-4e08-90ce-987a89ede21e
  modify #6bbc3747-a1d4-4477-a882-1147d2ab0618 attributes.reactions = [
    #01c8e173-b33d-48c3-9acf-0e53eaceb087 -> none ;
    #1cc4c504-edee-4da6-a2ca-3a2962d33f73 -> independent #cc199c5b-6916-4a8b-9a77-3f66401231da correlate #cc199c5b-6916-4a8b-9a77-3f66401231da payload.proposalId = payload.proposalId ;
    #c506b6ff-534c-4500-a483-c4b51a687be3 -> independent #72f8ee20-276f-4839-b462-dd9c32493e33 correlate #72f8ee20-276f-4839-b462-dd9c32493e33 payload.proposalId = payload.proposalId
  ]

  modify #aa87850c-c0f9-4a87-9a13-e807fb13c981 description = "Started by ProposalScored, one instance per (proposal, review round). Waits on the chair's decision (escalating to the officer after 14 days, never deciding by timeout); on award commits against the envelope and returns to the chair if the envelope would be exceeded; publishes ProposalAwarded or ProposalDeclined. Closed without a decision (CaseSuperseded) if the proposal returns to review first."
  modify #aa87850c-c0f9-4a87-9a13-e807fb13c981 attributes.StateContract = { proposalId: text, callId: text, round: int32, requested: #e5c742af-99db-489f-88e6-e71379949e18, meanScore: decimal(4,2), verdict: optional(#1dbdf7f0-470c-44aa-9ecb-017865d81fb8), acknowledgement: optional(#38802dd2-afd5-42fd-96d6-ad4303195d90), withinEnvelope: optional(boolean) } retention "instance-audit"
  modify #aa87850c-c0f9-4a87-9a13-e807fb13c981 attributes.trigger = #9d491b10-51c4-43b9-82e7-60ec7e806546{ proposalId: payload.proposalId, callId: payload.callId, round: payload.round, requested: payload.requested, meanScore: payload.meanScore } unique-by payload.caseKey
  modify #aa87850c-c0f9-4a87-9a13-e807fb13c981 version = v2

  add into #69ba4172-7586-46f0-91df-62340683f561 {
    workflow IntegrityReview v1 #be951c9b-20d9-478c-b93b-6e59cf0201f2 {
      desc "Started by DecisionSuspended. A program officer reviews a decision taken on a round that lost a counted review to a conflict, and records an explicit outcome: uphold (the decision stands with a recorded finding) or rescind (the decision is rescinded, an award's amount is released only if nothing was disbursed, and the proposal returns to review). Escalates; never decides by timeout."
      state { proposalId: #761d8b58-71fc-44a3-9cf4-b98a0c2c6a5c, callId: text, round: int32, decisionOutcome: #7fd5b3f8-e948-4722-ae22-7d14eee5f08b, integrity: optional(#110f6712-6475-481c-a38f-ae23bc811ed5) } retention "instance-audit"
      trigger = #b64619a6-b501-4eca-87e6-785a4408696d{ proposalId: payload.proposalId, callId: payload.callId, round: payload.round, decisionOutcome: payload.decisionOutcome } unique-by payload.caseKey
      triggeredBy: #cc199c5b-6916-4a8b-9a77-3f66401231da
      realizes: #04693827-6a72-4e25-8258-780b19c9ef5e
      satisfies: #0e1bb1de-82fe-4e08-90ce-987a89ede21e
      governedBy: #d5f5a5ad-ea05-41c7-9161-1165fe63d3a1
      deployedAs: #f872482d-f437-4310-a1b7-88136850da8e

      human-task review #ea130c05-c64a-4add-a850-f08f98ea970e {
        assign #6941c304-5ce8-478c-a354-e6ce19fdeee1
        escalation "after P14D without an outcome the panel chair is notified; the task stays open, the decision stays suspended and nothing is decided by timeout"
        cancellation "close-on-instance-termination"
        payload = #b64619a6-b501-4eca-87e6-785a4408696d{ proposalId: proposalId, callId: callId, round: round, decisionOutcome: decisionOutcome }
        outcome #110f6712-6475-481c-a38f-ae23bc811ed5 = result -> integrity = some(result)
        retention "task-audit"
      }
      decision isRescind #a1fef6a8-4dd5-47e2-b6be-e5dfa3cd1a57 = match integrity { none -> false; some o -> o.verdict == #232f03ba-a4ec-4649-aa4a-c48c0c569ee0 "rescind" }
      invoke rescind #edec420e-dfd7-48bb-99a4-77518d673201
        -> #66890c84-dd18-4d41-9915-feeae9814428
        in = #a03b21bb-1c3a-4579-9899-603d66d8511f{ proposalId: proposalId, round: round, release: match integrity { none -> false; some o -> o.fundsDisbursed == false } } policy[retry "bounded"; on-fail=retry]
      publish rescinded #8ad8a18b-e5eb-4f00-b9ed-80b12f413cd1
        -> #0973f86c-4a46-4ccd-bfbb-9d4f7bd886a2 payload = #5b5641a9-0585-4a68-9e0c-d7a67a814b91{ proposalId: proposalId, callId: callId, round: round, verdict: #232f03ba-a4ec-4649-aa4a-c48c0c569ee0 "rescind", releaseRequested: match integrity { none -> false; some o -> o.fundsDisbursed == false }, actorId: match integrity { none -> ""; some o -> o.actorId }, rationale: match integrity { none -> ""; some o -> o.rationale }, at: match integrity { none -> instant "1970-01-01T00:00:00Z"; some o -> o.at } }
      invoke uphold #1d8d2b1f-402b-4231-8334-d4143ac8b961
        -> #53f79a66-7301-4613-aa2f-7e1f01ed545b
        in = #5f6629fd-8b31-4555-94bd-5c9ad9080a76{ proposalId: proposalId, round: round } policy[retry "bounded"; on-fail=retry]
      publish upheld #7530f051-3f0d-402e-a515-c770c6bfa4f9
        -> #d4b74106-7eb1-45f7-9a98-ab296c519d74 payload = #5b5641a9-0585-4a68-9e0c-d7a67a814b91{ proposalId: proposalId, callId: callId, round: round, verdict: #232f03ba-a4ec-4649-aa4a-c48c0c569ee0 "uphold", releaseRequested: false, actorId: match integrity { none -> ""; some o -> o.actorId }, rationale: match integrity { none -> ""; some o -> o.rationale }, at: match integrity { none -> instant "1970-01-01T00:00:00Z"; some o -> o.at } }
      transition T1 #bd8156f7-5187-4557-bcfb-86c591789c23 : #ea130c05-c64a-4add-a850-f08f98ea970e -> #a1fef6a8-4dd5-47e2-b6be-e5dfa3cd1a57
      transition T2 #a52cf231-7139-441a-92cd-21ccbad14b96 : #a1fef6a8-4dd5-47e2-b6be-e5dfa3cd1a57 -> #edec420e-dfd7-48bb-99a4-77518d673201 when result
      transition T3 #cd3cb741-2bdb-48b1-8522-2e673b6b3502 : #a1fef6a8-4dd5-47e2-b6be-e5dfa3cd1a57 -> #1d8d2b1f-402b-4231-8334-d4143ac8b961 default
      transition T4 #20b5617c-3443-4d4d-85eb-d307f51a9935 : #edec420e-dfd7-48bb-99a4-77518d673201 -> #8ad8a18b-e5eb-4f00-b9ed-80b12f413cd1
      transition T5 #32f4997c-e264-4300-8cec-fcd47445b885 : #1d8d2b1f-402b-4231-8334-d4143ac8b961 -> #7530f051-3f0d-402e-a515-c770c6bfa4f9
    }
  }

  // Submission returns a rescinded proposal to review.
