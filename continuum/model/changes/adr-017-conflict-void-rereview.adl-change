  // ================================================================ Part 6 — verification
  modify #56ed25b9-9935-4b9c-b9a2-f074dd9f9213 description = "INV-3: assigning a conflicted reviewer is refused; declaring a conflict revokes the reviewer's assignment in the same transaction in every state, including completed."
  modify #005d1ac1-f9af-4907-9304-e4dae1d23e2d description = "INV-5: two submitted reviews leave the proposal under review; the third moves it to scored exactly once per round; a revoked assignment's or voided review does not count; a replacement's review closes a new round."
  modify #4e09e956-dc08-4447-9dc0-a232eb38cdf2 description = "INV-8: an officer recording a decision is refused; a chair recording one for an unscored proposal is refused; a second decision in the same round is refused; a decision while an integrity hold is on the case is refused."
  add into #88e48015-97bf-4375-b558-fb8ba04e97fe {
    test Inv03ConflictVoidsReviewAtEveryPhase #fa434955-2d88-4ded-871d-67fb9fd72173 {
      desc "INV-3 consequence, phases 1-4: a conflict before assignment refuses it; on a live assignment revokes it; on a submitted review before scoring voids it and the count drops; after scoring voids the counted review, supersedes the round, returns the proposal to UnderReview, supersedes the open case (also from reconsider and from a hold), and a replacement's review closes round 2 with a mean that excludes the voided review. Races: conflict vs third review, conflict vs chair decision."
      verifies: #70b1cfaf-b8de-49a9-ac51-86938e7aaf2b, #0e1bb1de-82fe-4e08-90ce-987a89ede21e, #1a2bf939-5081-451d-b2f9-e64695741bf5, #7e9ffd9e-4f58-4754-a0da-2140ddd22984, #0d09ec42-5b02-46f6-969f-d65bc15aef6c
    }
  }
  add into #88e48015-97bf-4375-b558-fb8ba04e97fe {
    test ConflictAfterDecisionIntegrityReview #70d4b958-f02e-4160-bf97-0cd6f6251b44 {
      desc "INV-3 consequence, phase 5: a conflict after an award or a decline suspends the decision once; uphold lifts it with a finding and changes no budget; rescind of an undisbursed award releases its amount exactly once and returns the proposal to review; rescind with funds disbursed releases nothing; the re-decision is a new round's decision."
      verifies: #0e1bb1de-82fe-4e08-90ce-987a89ede21e, #be951c9b-20d9-478c-b93b-6e59cf0201f2, #6bbc3747-a1d4-4477-a882-1147d2ab0618
    }
  }
}
